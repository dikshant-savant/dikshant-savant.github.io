---
const stats = [
  { value: "24", suffix: "%", label: "Cold email reply rate vs. ~3% industry benchmark" },
  { value: "$9,600", suffix: "/mo", label: "Ops spend avoided by catching a bad vendor claim before scale-up" },
  { value: "98", suffix: "%+", label: "Email verification accuracy, independently re-checked" },
  { value: "18,000", suffix: "+", label: "Pages, records & contacts live in production" },
];
---

<section class="font-serif border-b border-[var(--border-strong)]">
  <div class="mx-auto grid max-w-6xl grid-cols-2 px-6 md:grid-cols-4">
    {
      stats.map((stat, i) => (
        <div
          class:list={[
            "flex flex-col gap-2.5 border-[var(--border)] py-12 pr-4 md:pr-8",
            i < 3 && "md:border-r",
            i % 2 === 0 && "border-r md:border-r-0",
            i < 2 && "border-b md:border-b-0",
          ]}
        >
          <span class="text-4xl leading-none tracking-tight whitespace-nowrap text-[var(--text)] md:text-6xl">
            {stat.value}<span class="text-[var(--v2-accent)]">{stat.suffix}</span>
          </span>
          <span class="text-[13px] tracking-[0.18em] text-[var(--text-muted)] uppercase">
            {stat.label}
          </span>
        </div>
      ))
    }
  </div>
</section>
