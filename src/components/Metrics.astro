---
const stats = [
  { value: "24%", label: "Cold email reply rate vs. ~3% industry benchmark" },
  { value: "$9,600/mo", label: "Ops spend avoided by catching a bad vendor claim before scale-up" },
  { value: "98%+", label: "Email verification accuracy, independently re-checked" },
  { value: "18,000+", label: "Pages, records and contacts live in production" },
];
---

<section class="border-b border-[var(--hairline)] bg-[var(--canvas-soft)]">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 divide-x divide-y divide-[var(--hairline)] px-6 lg:grid-cols-4 lg:divide-y-0">
    {
      stats.map((stat) => (
        <div class="flex flex-col gap-2 py-10 pr-4 pl-1 first:pl-0 md:pr-8">
          <span class="display-lg text-2xl text-[var(--ink)] sm:text-3xl md:text-4xl">{stat.value}</span>
          <span class="font-mono-ui text-xs leading-snug text-[var(--mute)]">{stat.label}</span>
        </div>
      ))
    }
  </div>
</section>
