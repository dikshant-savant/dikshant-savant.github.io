---
import { Image } from "astro:assets";
import headshot from "../assets/profile/headshot-suit.jpg";
import iitLogo from "../assets/education/iit-patna.png";
import georgetownLogo from "../assets/education/georgetown.jpg";
---

<section id="top" class="relative overflow-hidden bg-[var(--canvas)]">
  <div class="mesh-gradient pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--canvas)]" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-[1400px] items-start gap-12 px-6 pt-20 pb-16 md:grid-cols-[1.1fr_400px] md:gap-16 md:pt-24 lg:px-10">
    <div class="flex flex-col items-start text-left">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--hairline)] bg-[var(--canvas)]/80 px-4 py-1.5 shadow-card backdrop-blur-sm">
        <span class="font-mono-ui text-xs tracking-tight text-[var(--body)]">AI Product Manager</span>
      </div>

      <h1 class="display-xl mt-8 max-w-[16ch] text-[40px] text-[var(--ink)] sm:text-6xl md:text-[64px]">
        I build AI-powered growth systems, 0 to 1.
      </h1>

      <p class="mt-6 max-w-[46ch] text-lg leading-[1.55] text-[var(--body)]">
        Data pipelines, LLM tooling, and outbound infrastructure, designed, built, and shipped by one person.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#work"
          class="rounded-full bg-[var(--ink)] px-6 py-3 text-base font-medium text-[var(--on-primary)] transition-transform active:scale-[0.98]"
        >
          See my work
        </a>
        <a
          href="#contact"
          class="rounded-full border border-[var(--hairline)] bg-[var(--canvas)] px-6 py-3 text-base font-medium text-[var(--ink)] transition-colors hover:border-[var(--hairline-strong)] active:scale-[0.98]"
        >
          Get in touch
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div class="overflow-hidden rounded-2xl shadow-card-lg" style="aspect-ratio: 4 / 5;">
        <Image src={headshot} alt="Dikshant Savant" width={480} height={600} class="h-full w-full object-cover object-top" />
      </div>

      <div class="flex flex-col gap-4 rounded-2xl border border-[var(--hairline)] bg-[var(--canvas)] p-5 shadow-card">
        <span class="font-mono-ui text-xs tracking-tight text-[var(--mute)]">Education</span>
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2.5">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-full border border-[var(--hairline)] bg-[var(--canvas)] p-0.5">
              <Image src={georgetownLogo} alt="Georgetown University, McDonough School of Business" width={64} height={64} class="h-full w-full object-contain" />
            </div>
            <span class="text-sm text-[var(--body)]">Georgetown McDonough School of Business, MBA, 2024</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--hairline)] bg-[var(--canvas)] p-1">
              <Image src={iitLogo} alt="IIT Patna" width={64} height={64} class="h-full w-full object-contain" />
            </div>
            <span class="text-sm text-[var(--body)]">IIT Patna, B.Tech Electrical Engineering, 2016</span>
          </div>
        </div>
        <a
          href="/dikshant-savant-resume.pdf"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-1.5 rounded-full bg-[var(--ink)] px-5 py-2.5 text-sm font-medium text-[var(--on-primary)] transition-opacity hover:opacity-85"
        >
          View resume ↗
        </a>
      </div>
    </div>
  </div>
</section>
