---
import { Image } from "astro:assets";
import headshot from "../assets/profile/headshot-suit.jpg";
import iitLogo from "../assets/education/iit-patna.png";
import georgetownLogo from "../assets/education/georgetown.jpg";
---

<section id="top" class="bg-[var(--ink)] text-[var(--ink-text)]" style="font-family: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, sans-serif;">
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-20 md:pt-24 md:pb-24">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr] md:items-center md:gap-16">
      <div class="flex flex-col gap-6">
        <p class="font-mono-ui text-xs tracking-[0.14em] text-[var(--ink-accent)] uppercase">
          AI Product Manager
        </p>
        <h1 class="font-display max-w-[16ch] pb-1 text-4xl leading-[1.1] font-semibold tracking-tight md:text-6xl">
          I build AI-powered growth systems, end to end.
        </h1>
        <p class="max-w-[44ch] text-lg leading-[1.6] text-[var(--ink-text-muted)]">
          Data pipelines, LLM tooling, and outbound infrastructure &mdash;
          designed, built, and shipped by one person.
        </p>
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href="#work"
            class="rounded-full px-6 py-3.5 text-sm font-semibold text-[var(--accent-contrast)] transition-transform active:scale-[0.98]"
            style="background: var(--accent)"
          >
            See what I've built
          </a>
          <a
            href="#contact"
            class="rounded-full border border-white/30 px-6 py-3.5 text-sm font-semibold text-[var(--ink-text)] transition-colors hover:border-white hover:bg-white/[0.06] active:scale-[0.98]"
          >
            Get in touch
          </a>
        </div>
      </div>

      <div class="aspect-[3/2] w-full max-w-[480px] justify-self-center overflow-hidden rounded-2xl md:justify-self-end">
        <Image src={headshot} alt="Dikshant Savant" width={1999} height={1333} class="h-full w-full object-cover" />
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-5 border-t border-[var(--ink-border)] pt-8 sm:flex-row sm:items-center sm:gap-10">
      <span class="font-mono-ui shrink-0 text-xs tracking-[0.14em] text-[var(--ink-text-muted)] uppercase">Education</span>
      <div class="flex flex-wrap items-center gap-x-9 gap-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white p-1.5">
            <Image src={iitLogo} alt="IIT Patna" width={80} height={80} class="h-full w-full object-contain" />
          </div>
          <span class="text-sm text-[var(--ink-text)]">IIT Patna &middot; B.Tech, Electrical Engineering, 2016</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white p-1">
            <Image src={georgetownLogo} alt="Georgetown University, McDonough School of Business" width={80} height={80} class="h-full w-full object-contain" />
          </div>
          <span class="text-sm text-[var(--ink-text)]">Georgetown University, McDonough School of Business &middot; MBA, 2024</span>
        </div>
      </div>
    </div>
  </div>
</section>
