---
---

<section id="top" class="bg-[var(--ink)] text-[var(--ink-text)]">
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-14 md:pt-24 md:pb-16">
    <p class="font-mono-ui text-xs tracking-[0.14em] text-[var(--ink-accent)] uppercase">
      AI product manager &amp; founder
    </p>
    <h1 class="font-display mt-8 max-w-[18ch] text-5xl leading-[0.98] font-medium tracking-tight md:text-7xl">
      I take products from <em class="text-[var(--ink-accent)] italic">zero to shipped</em> — then grow them.
    </h1>

    <div class="mt-9 grid gap-10 border-t border-[var(--ink-border)] pt-9 md:grid-cols-[1.2fr_1fr] md:items-end">
      <div class="flex flex-col gap-6">
        <p class="max-w-[48ch] text-lg leading-[1.6] text-[var(--ink-text-muted)]">
          I work across product, growth, data, and AI engineering. I don't
          just build the feature — I define who it's for, launch it, and
          build the machine that gets it in front of people.
        </p>
        <div class="flex flex-wrap items-center gap-3.5">
          <a
            href="#work"
            class="px-6 py-3.5 text-sm font-semibold text-[var(--accent-contrast)] transition-colors"
            style="background: var(--accent)"
          >
            See the work
          </a>
          <a
            href="#contact"
            class="border border-white/30 px-6 py-3.5 text-sm font-semibold text-[var(--ink-text)] transition-colors hover:border-white hover:bg-white/[0.06]"
          >
            Get in touch
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-5 text-sm">
        <div class="flex justify-between gap-4 border-b border-[var(--ink-border)] pb-3">
          <span class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--ink-text-muted)] uppercase">Location</span>
          <span class="text-right text-[var(--ink-text)]">India &middot; remote</span>
        </div>
        <div class="flex justify-between gap-4 border-b border-[var(--ink-border)] pb-3">
          <span class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--ink-text-muted)] uppercase">Building</span>
          <span class="text-right text-[var(--ink-text)]">Capablanca AI / NeverMissABooking&trade;, Our Inner Universe</span>
        </div>
        <div class="flex justify-between gap-4">
          <span class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--ink-text-muted)] uppercase">Method</span>
          <span class="max-w-[26ch] text-right text-[var(--ink-text)]">Smallest useful version first, ship to real users fast, then build the growth engine that doesn't need me running it by hand</span>
        </div>
      </div>
    </div>
  </div>
</section>
