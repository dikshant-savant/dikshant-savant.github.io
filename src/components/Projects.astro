---
import { Image } from "astro:assets";
import slickShot from "../assets/projects/slickonboard-app.png";
import ouShot from "../assets/projects/ourinneruniverse.png";
import tinkleShot from "../assets/projects/tinkletreeco.png";
---

<section id="work" class="scroll-mt-16 border-b border-[var(--border)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-baseline justify-between border-b border-[var(--border)] pb-4">
      <h2 class="font-display text-3xl font-medium tracking-tight text-[var(--text)] md:text-[44px]">
        Selected work
      </h2>
      <span class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--text-muted)] uppercase">04 projects</span>
    </div>

    <div class="mt-11 grid gap-6 md:grid-cols-[2fr_1fr]">
      <a
        id="p-slickonboard"
        href="https://slickonboard.com"
        target="_blank"
        rel="noopener"
        class="group flex flex-col border border-[var(--border)] bg-[var(--surface)] scroll-mt-24"
      >
        <div class="aspect-[16/9] overflow-hidden border-b border-[var(--border)]">
          <Image src={slickShot} alt="SlickOnboard marketing homepage" width={800} height={500} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" />
        </div>
        <div class="flex flex-col gap-3.5 p-8">
          <p class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--accent)] uppercase">Onboarding automation</p>
          <h3 class="font-display text-3xl font-medium text-[var(--text)]">SlickOnboard</h3>
          <p class="max-w-[52ch] text-base leading-relaxed text-[var(--text-muted)]">
            A client signs a contract, and the rest of the setup happens
            automatically.
          </p>
          <div class="flex flex-wrap gap-2 pt-1.5">
            {["n8n", "OpenAI", "Supabase"].map((tag) => (
              <span class="font-mono-ui border border-[var(--border)] px-2.5 py-1 text-[11px] text-[var(--text-muted)]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </a>

      <div class="flex flex-col gap-6">
        <a
          id="p-inner-universe"
          href="https://ourinneruniverse.com"
          target="_blank"
          rel="noopener"
          class="group flex flex-1 flex-col border border-[var(--border)] bg-[var(--surface)] scroll-mt-24"
        >
          <div class="aspect-[16/10] overflow-hidden border-b border-[var(--border)]">
            <Image src={ouShot} alt="Our Inner Universe homepage" width={800} height={500} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" />
          </div>
          <div class="flex flex-col gap-2.5 p-5">
            <h3 class="font-display text-xl font-medium text-[var(--text)]">Our Inner Universe</h3>
            <p class="text-sm leading-relaxed text-[var(--text-muted)]">
              Built a system that generates and manages 7,000+ pages from a
              single data model.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-0.5">
              {["Astro", "Claude", "pSEO"].map((tag) => (
                <span class="font-mono-ui border border-[var(--border)] px-2 py-0.5 text-[10px] text-[var(--text-muted)]">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>

        <a
          id="p-tinkletree"
          href="https://tinkletreeco.com"
          target="_blank"
          rel="noopener"
          class="group flex flex-1 flex-col border border-[var(--border)] bg-[var(--surface)] scroll-mt-24"
        >
          <div class="aspect-[16/10] overflow-hidden border-b border-[var(--border)]">
            <Image src={tinkleShot} alt="TinkleTree Co checkout redirect page" width={800} height={500} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" />
          </div>
          <div class="flex flex-col gap-2.5 p-5">
            <h3 class="font-display text-xl font-medium text-[var(--text)]">TinkleTree Co</h3>
            <p class="text-sm leading-relaxed text-[var(--text-muted)]">
              Built the storefront and automated parts of the product and
              email workflow.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-0.5">
              {["Shopify", "Klaviyo"].map((tag) => (
                <span class="font-mono-ui border border-[var(--border)] px-2 py-0.5 text-[10px] text-[var(--text-muted)]">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      </div>
    </div>

    <a
      id="p-suresku"
      href="https://suresku.com/"
      target="_blank"
      rel="noopener"
      class="group mt-6 flex scroll-mt-24 flex-col items-start justify-between gap-3 border border-dashed border-[var(--border)] p-7 transition-colors hover:border-solid hover:border-[var(--accent)] sm:flex-row sm:items-center"
    >
      <div class="flex flex-col gap-1.5">
        <h3 class="font-display text-xl font-medium text-[var(--text)]">sureSKU</h3>
        <p class="max-w-[60ch] text-sm text-[var(--text-muted)]">
          Inventory forecasting for small catalogs. Building now.
        </p>
      </div>
      <span class="font-mono-ui shrink-0 text-[11px] tracking-[0.1em] text-[var(--text-muted)] uppercase">In progress</span>
    </a>
  </div>
</section>
