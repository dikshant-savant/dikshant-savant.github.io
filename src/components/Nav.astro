---
const links = [
  { href: "#work", label: "Work" },
  { href: "#case-flagship", label: "Case studies" },
  { href: "#skills", label: "Skills" },
  { href: "#about", label: "About" },
];
---

<header class="sticky top-0 z-40 border-b border-[var(--hairline)] bg-[var(--canvas)]/90 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-6 px-6 lg:px-10">
    <a href="#top" class="display-md text-[15px] text-[var(--ink)]">
      Dikshant Savant
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-3 py-2 text-sm text-[var(--body)] transition-colors hover:bg-[var(--canvas-soft)] hover:text-[var(--ink)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/dikshant-savant-resume.pdf"
          target="_blank"
          rel="noopener"
          class="rounded-full px-3 py-2 text-sm text-[var(--body)] transition-colors hover:bg-[var(--canvas-soft)] hover:text-[var(--ink)]"
        >
          Resume
        </a>
      </li>
    </ul>

    <a
      href="#contact"
      class="shrink-0 rounded-[6px] bg-[var(--ink)] px-3 text-sm font-medium text-[var(--on-primary)] transition-opacity hover:opacity-85"
      style="height: 28px; line-height: 28px;"
    >
      Contact
    </a>
  </nav>
</header>
