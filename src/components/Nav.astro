---
const links = [
  { href: "#work", label: "Work" },
  { href: "#case-flagship", label: "Case studies" },
  { href: "#skills", label: "Skills" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="sticky top-0 z-40 border-b border-[var(--ink-border)] bg-[var(--ink)]/92 backdrop-blur-md"
>
  <nav
    class="font-mono-ui mx-auto flex h-16 max-w-6xl items-center justify-between px-6 text-xs tracking-[0.06em] text-[var(--ink-text-muted)]"
  >
    <a href="#top" class="font-medium text-[var(--ink-text)]">
      DIKSHANT SAVANT
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="uppercase transition-colors hover:text-[var(--ink-text)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
