---
const links = [
  { href: "#work", label: "Work" },
  { href: "#case-flagship", label: "Case studies" },
  { href: "#skills", label: "Skills" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="font-serif sticky top-0 z-40 border-b border-[var(--border-strong)] bg-[var(--bg)]/94 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-[58px] max-w-6xl items-center justify-between gap-5 px-6 text-[var(--text-faint)]"
  >
    <a href="#top" class="text-lg tracking-[0.14em] text-[var(--text)] uppercase">
      Dikshant Savant
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm tracking-[0.16em] uppercase transition-colors hover:text-[var(--v2-accent)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
