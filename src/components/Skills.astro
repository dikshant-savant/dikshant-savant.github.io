---

<section id="skills" class="scroll-mt-16 border-b border-[var(--border)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-baseline justify-between border-b border-[var(--border)] pb-4">
      <h2 class="font-display text-3xl font-medium tracking-tight text-[var(--text)] md:text-[44px]">
        What I use
      </h2>
      <span class="font-mono-ui hidden text-[11px] tracking-[0.1em] text-[var(--text-muted)] uppercase sm:inline">Most of these skills are linked to something I've actually built with them</span>
    </div>

    <div class="mt-4 flex flex-col">
      {
        groups.map((group) => (
          <div class="grid gap-3 border-b border-[var(--border)] py-6 md:grid-cols-[190px_1fr_1.1fr] md:items-baseline md:gap-8">
            <p class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--accent)] uppercase">{group.name}</p>
            <p class="text-base leading-[1.7] text-[var(--text-muted)]">{group.tools}</p>
            <div class="flex flex-wrap gap-x-3.5 gap-y-1.5 text-sm">
              {group.proof.map((p) => (
                <a
                  href={p.href}
                  class="border-b border-[var(--border)] text-[var(--text)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
                >
                  {p.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
