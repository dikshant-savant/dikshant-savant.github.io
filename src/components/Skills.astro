---
const groups = [
  { name: "AI", tools: "OpenAI · Claude · structured outputs · prompt workflows" },
  { name: "Data", tools: "Python · SQL · scraping · enrichment · verification · data cleaning" },
  { name: "Automation", tools: "GoHighLevel · n8n · Make · Zapier · APIs · webhooks" },
  { name: "Web & infrastructure", tools: "Supabase · Vercel · Cloudflare · DNS · cron jobs · databases" },
  { name: "Growth", tools: "Cold email · deliverability · SEO · lifecycle email · landing pages · positioning" },
];
---

<section id="skills" class="scroll-mt-16 border-b border-[var(--border)] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-[var(--text)] md:text-[44px]">
      Things I know how to work with
    </h2>
    <p class="mt-3 max-w-[52ch] text-lg text-[var(--text-muted)]">
      I'm less interested in collecting skills than using whatever is needed to finish the project.
    </p>

    <div class="mt-10 flex flex-col divide-y divide-[var(--border)]">
      {
        groups.map((group) => (
          <div class="grid gap-3 py-6 md:grid-cols-[220px_1fr] md:items-baseline md:gap-8">
            <p class="font-semibold text-[var(--text)]">{group.name}</p>
            <p class="text-base leading-[1.7] text-[var(--text-muted)]">{group.tools}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
