---
const groups = [
  {
    name: "AI",
    tools: "OpenAI · Claude · structured outputs · prompt workflows",
    proof: [
      { label: "SlickOnboard", href: "#p-slickonboard" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "Outbound pipeline", href: "#p-outbound" },
      { label: "NeverMissABooking", href: "#p-nmab" },
    ],
  },
  {
    name: "Data",
    tools: "Python · SQL · scraping · enrichment · verification · data cleaning",
    proof: [
      { label: "Outbound pipeline", href: "#p-outbound" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "sureSKU", href: "#p-suresku" },
    ],
  },
  {
    name: "Automation",
    tools: "GoHighLevel · n8n · Make · Zapier · APIs · webhooks",
    proof: [
      { label: "NeverMissABooking", href: "#p-nmab" },
      { label: "SlickOnboard", href: "#p-slickonboard" },
      { label: "TinkleTree Co", href: "#p-tinkletree" },
    ],
  },
  {
    name: "Web & infrastructure",
    tools: "Supabase · Vercel · Cloudflare · DNS · cron jobs · databases",
    proof: [
      { label: "SlickOnboard", href: "#p-slickonboard" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "NeverMissABooking", href: "#p-nmab" },
    ],
  },
  {
    name: "Growth",
    tools: "Cold email · deliverability · SEO · lifecycle email · landing pages · positioning",
    proof: [
      { label: "Outbound pipeline", href: "#p-outbound" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "TinkleTree Co", href: "#p-tinkletree" },
    ],
  },
];
---

<section id="skills" class="font-serif scroll-mt-16 border-b border-[var(--border-strong)] py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-baseline justify-between border-b border-[var(--border-strong)] pb-5">
      <h2 class="text-lg tracking-[0.22em] text-[var(--text)] uppercase">
        Things I know how to work with
      </h2>
      <span class="hidden text-[13px] tracking-[0.18em] text-[var(--text-faint)] uppercase sm:inline">Every skill links to proof</span>
    </div>

    <div class="flex flex-col">
      {
        groups.map((group) => (
          <div class="grid items-baseline gap-6 border-b border-[var(--border)] py-8 md:grid-cols-[210px_1fr_280px]">
            <p class="text-base tracking-[0.16em] text-[var(--v2-accent)] uppercase">{group.name}</p>
            <p class="text-xl leading-[1.6] text-[var(--text-body)]">{group.tools}</p>
            <div class="flex flex-col gap-1.5 text-lg italic">
              {group.proof.map((p) => (
                <a
                  href={p.href}
                  class="w-fit border-b border-[var(--border)] pb-0.5 text-[var(--text)] transition-colors hover:text-[var(--v2-accent)]"
                >
                  {p.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
