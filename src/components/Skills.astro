---
const groups = [
  {
    name: "AI",
    tools: "OpenAI, Claude, structured outputs, prompt workflows",
    proof: [
      { label: "SlickOnboard", href: "#p-slickonboard" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "Outbound pipeline", href: "#p-outbound" },
      { label: "NeverMissABooking", href: "#p-nmab" },
    ],
  },
  {
    name: "Data",
    tools: "Python, SQL, scraping, enrichment, verification, data cleaning",
    proof: [
      { label: "Outbound pipeline", href: "#p-outbound" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "sureSKU", href: "#p-suresku" },
    ],
  },
  {
    name: "Automation",
    tools: "GoHighLevel, n8n, Make, Zapier, APIs, webhooks",
    proof: [
      { label: "NeverMissABooking", href: "#p-nmab" },
      { label: "SlickOnboard", href: "#p-slickonboard" },
      { label: "TinkleTree Co", href: "#p-tinkletree" },
    ],
  },
  {
    name: "Web & infrastructure",
    tools: "Supabase, Vercel, Cloudflare, DNS, cron jobs, databases",
    proof: [
      { label: "SlickOnboard", href: "#p-slickonboard" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "NeverMissABooking", href: "#p-nmab" },
    ],
  },
  {
    name: "Growth",
    tools: "Cold email, deliverability, SEO, lifecycle email, landing pages, positioning",
    proof: [
      { label: "Outbound pipeline", href: "#p-outbound" },
      { label: "Our Inner Universe", href: "#p-inner-universe" },
      { label: "TinkleTree Co", href: "#p-tinkletree" },
    ],
  },
];
---

<section id="skills" class="scroll-mt-16 border-b border-[var(--hairline)] bg-[var(--canvas-soft)] py-20 md:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <h2 class="display-lg max-w-[16ch] text-3xl text-[var(--ink)] md:text-[40px]">
      Things I know how to work with.
    </h2>

    <div class="mt-12 overflow-hidden rounded-xl bg-[var(--canvas)] shadow-card">
      {
        groups.map((group) => (
          <div class="grid items-baseline gap-3 border-b border-[var(--hairline)] p-6 last:border-b-0 md:grid-cols-[200px_1fr_auto] md:gap-8 md:p-8">
            <p class="text-base font-medium text-[var(--ink)]">{group.name}</p>
            <p class="text-[15px] leading-relaxed text-[var(--body)]">{group.tools}</p>
            <div class="flex flex-wrap gap-1.5">
              {group.proof.map((p) => (
                <a
                  href={p.href}
                  class="rounded-full bg-[var(--canvas-soft)] px-2.5 py-1 text-xs text-[var(--body)] transition-colors hover:bg-[var(--ink)] hover:text-[var(--on-primary)]"
                >
                  {p.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
