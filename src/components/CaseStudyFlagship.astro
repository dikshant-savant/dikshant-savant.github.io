---
import { Image } from "astro:assets";
import nmabShot from "../assets/projects/nevermissabooking.png";

const modules = [
  "Missed-call capture & response",
  "AI-driven booking",
  "No-show reminder system",
  "Review-request funnel",
];

const blocks = [
  {
    label: "Problem",
    body: "The original problem was pretty simple. A business misses a phone call. The person calling might be ready to buy. Nobody calls them back quickly enough. The lead is gone. I started building a solution for CDL driving schools, where staff can be busy teaching when calls come in.",
  },
  {
    label: "Action",
    body: "The first version got too complicated. I had built a huge workflow with all kinds of branches and escalation logic. Then I cut most of it. The product didn't need all that. The core promise was simple: if you miss a call, the person gets a response. So that's what I focused on. Getting it ready for customers also meant dealing with things that weren't really \"product work\": setting up the company, getting an EIN, working through Twilio's A2P registration, and figuring out platform limitations as they came up.",
  },
  {
    label: "Result",
    body: "The first clients are now using the same core system.",
  },
];

const stats = [
  { value: "4", label: "Clients onboarded" },
  { value: "4 × $997/mo", label: "MRR" },
];
---

<section id="case-flagship" class="scroll-mt-16 border-b border-[var(--hairline)] bg-[var(--canvas)] py-20 md:py-28">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <h2 class="display-lg max-w-[14ch] text-3xl text-[var(--ink)] md:text-[40px]">
      Case studies.
    </h2>
    <p class="mt-3 max-w-[52ch] text-lg text-[var(--body)]">
      Three of the projects above, in more depth: the problem, what I actually built, and what happened.
    </p>

    <div class="mt-14 grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <div class="inline-flex items-center gap-3">
          <span class="font-mono-ui flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--hairline)] text-xs text-[var(--mute)]">01</span>
          <span class="font-mono-ui text-xs tracking-tight text-[var(--mute)]">Case study</span>
        </div>
        <h2 class="display-lg mt-4 max-w-[18ch] text-3xl text-[var(--ink)] md:text-[44px]">
          NeverMissABooking: from an idea to something customers could use.
        </h2>
        <p class="mt-5 max-w-[46ch] text-lg leading-[1.55] text-[var(--body)]">
          A missed-call system for CDL driving schools, built solo from first workflow sketch to paying customers.
        </p>
      </div>
      <div class="overflow-hidden rounded-2xl bg-[var(--canvas-soft-2)] shadow-card-lg" style="aspect-ratio: 16 / 10;">
        <Image src={nmabShot} alt="NeverMissABooking marketing homepage" width={800} height={500} class="h-full w-full object-cover" />
      </div>
    </div>

    <div class="mt-14 overflow-hidden rounded-2xl border border-[var(--hairline)] bg-[var(--canvas-soft)] shadow-card-lg md:mt-20">
      <div class="grid gap-8 p-8 md:grid-cols-3 md:p-10">
        {
          blocks.map((block) => (
            <div class="flex flex-col gap-2.5">
              <p class="font-mono-ui text-xs tracking-tight text-[var(--mute)]">{block.label}</p>
              <p class="text-[15px] leading-relaxed text-[var(--body)]">{block.body}</p>
            </div>
          ))
        }
      </div>
      <div class="flex flex-wrap gap-2 border-t border-[var(--hairline)] p-8 md:p-10 md:pt-6">
        {
          modules.map((mod) => (
            <span class="font-mono-ui rounded-full bg-[var(--canvas)] px-3 py-1.5 text-xs text-[var(--body)] shadow-card">{mod}</span>
          ))
        }
      </div>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4">
      {
        stats.map((stat) => (
          <div class="rounded-xl border border-[var(--hairline)] bg-[var(--canvas-soft)] p-6">
            <span class="display-lg block text-3xl text-[var(--ink)] md:text-4xl">{stat.value}</span>
            <span class="font-mono-ui mt-1.5 block text-xs text-[var(--mute)]">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
