---
const modules = [
  "Missed-call capture & response",
  "AI-driven booking",
  "No-show reminder system",
  "Review-request funnel",
];

const blocks = [
  {
    label: "Problem",
    body: "The original problem was pretty simple. A business misses a phone call. The person calling might be ready to buy. Nobody calls them back quickly enough. The lead is gone. I started building a solution for CDL driving schools, where staff can be busy teaching when calls come in.",
  },
  {
    label: "Action",
    body: "The first version got too complicated. I had built a huge workflow with all kinds of branches and escalation logic. Then I cut most of it. The product didn't need all that. The core promise was simple: if you miss a call, the person gets a response. So that's what I focused on. Getting it ready for customers also meant dealing with things that weren't really \"product work\": setting up the company, getting an EIN, working through Twilio's A2P registration, and figuring out platform limitations as they came up.",
  },
  {
    label: "Result",
    body: "The first clients are now using the same core system.",
  },
];

const stats = [
  { value: "4", label: "Clients onboarded" },
  { value: "4 × $997/mo", label: "MRR" },
];
---

<section id="case-flagship" class="font-serif scroll-mt-16 border-b border-[var(--border-strong)] py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col gap-7 border-b border-[var(--border)] pb-14">
      <p class="text-sm tracking-[0.22em] text-[var(--v2-accent)] uppercase">Case study 01</p>
      <h2 class="max-w-[24ch] text-4xl leading-[1.06] tracking-tight text-[var(--text)] md:text-6xl">
        NeverMissABooking&trade;: from an idea to <span class="text-[var(--v2-accent)]">something customers could use</span>
      </h2>
    </div>

    <div class="grid gap-10 py-14 md:grid-cols-3">
      {
        blocks.map((block) => (
          <div class="flex flex-col gap-3.5">
            <p class="text-sm tracking-[0.18em] text-[var(--text-faint)] uppercase">{block.label}</p>
            <p class="text-lg leading-[1.68] text-[var(--text-body)] text-pretty">{block.body}</p>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col gap-2 border border-[var(--border)] p-6">
      {
        modules.map((mod, i) => (
          <div class="flex items-center gap-4 border-b border-[var(--border)] py-2.5 last:border-b-0">
            <span class="text-sm text-[var(--text-faint)]">0{i + 1}</span>
            <span class="text-lg text-[var(--text)]">{mod}</span>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-2 border-t border-[var(--border)]">
      {
        stats.map((stat, i) => (
          <div
            class:list={[
              "flex flex-col gap-2 py-10 pr-6",
              i === 0 && "border-r border-[var(--border)]",
              i === 1 && "pl-6",
            ]}
          >
            <span class="text-4xl leading-none whitespace-nowrap text-[var(--text)] md:text-5xl">{stat.value}</span>
            <span class="text-[13px] tracking-[0.18em] text-[var(--text-muted)] uppercase">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
