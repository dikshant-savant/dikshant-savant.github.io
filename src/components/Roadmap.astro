---
const items = [
  { name: "Vedic Astrology Chart Engine", body: "Trying to build a proper Vedic chart calculator that runs entirely in the browser." },
  { name: "OneTinyWin", body: "A small accountability experiment delivered through email." },
  { name: "NetworkingFollowUp.com", body: "Because I meet people and then completely forget to follow up." },
  { name: "SoundAmerican", body: "Something I'm building around accent training for people preparing to work in the US." },
];
---

<section class="border-b border-[var(--border)] py-16">
  <div class="mx-auto max-w-6xl px-6">
    <p class="font-display text-lg font-semibold text-[var(--text)]">
      Also messing around with
    </p>
    <div class="mt-6 grid gap-x-6 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <div class="rounded-2xl bg-[var(--surface-alt)] p-5">
            <p class="text-sm font-semibold text-[var(--text)]">{item.name}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
