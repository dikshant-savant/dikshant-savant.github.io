---
const items = [
  { name: "Vedic Astrology Chart Engine", body: "Trying to build a proper Vedic chart calculator that runs entirely in the browser." },
  { name: "OneTinyWin", body: "A small accountability experiment delivered through email." },
  { name: "NetworkingFollowUp.com", body: "Because I meet people and then completely forget to follow up." },
  { name: "SoundAmerican", body: "Something I'm building around accent training for people preparing to work in the US." },
];
---

<section class="font-serif border-b border-[var(--border-strong)] py-16">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-sm tracking-[0.18em] text-[var(--text-faint)] uppercase">
      Also messing around with
    </p>
    <div class="mt-6 grid divide-y divide-[var(--border)] border-t border-[var(--border)] sm:grid-cols-2 sm:divide-y-0 sm:border-t-0 lg:grid-cols-4">
      {
        items.map((item, i) => (
          <div class:list={["py-5 sm:py-0 sm:pt-0", i > 0 && "sm:border-l sm:border-[var(--border)] sm:pl-6"]}>
            <p class="text-lg text-[var(--text)]">{item.name}</p>
            <p class="mt-1.5 text-base leading-relaxed text-[var(--text-muted)]">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
