---
const items = [
  { name: "Vedic Astrology Chart Engine", body: "Trying to build a proper Vedic chart calculator that runs entirely in the browser." },
  { name: "OneTinyWin", body: "A small accountability experiment delivered through email." },
  { name: "NetworkingFollowUp.com", body: "Because I meet people and then completely forget to follow up." },
  { name: "SoundAmerican", body: "Something I'm building around accent training for people preparing to work in the US." },
];
---

<section class="border-b border-[var(--hairline)] bg-[var(--canvas-soft)] py-16">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <p class="text-base font-medium text-[var(--ink)]">Also messing around with</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <div class="rounded-xl bg-[var(--canvas)] p-5 shadow-card">
            <p class="text-[15px] font-medium text-[var(--ink)]">{item.name}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--mute)]">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
