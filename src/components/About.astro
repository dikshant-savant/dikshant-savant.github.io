---
const chips = ["Self-taught", "3 yrs in production", "Solo builder", "Remote"];
---

<section id="about" class="scroll-mt-16 border-b border-[var(--border)] bg-[var(--surface-alt)] py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-[240px_1fr] md:gap-14">
    <div class="flex flex-col gap-3">
      <div class="font-display flex aspect-[4/5] items-center justify-center border border-[var(--border)] bg-[var(--bg)] text-4xl text-[var(--text-muted)]">
        DS
      </div>
      <span class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--text-muted)] uppercase">About</span>
    </div>

    <div class="flex flex-col gap-8">
      <p class="font-display max-w-[24ch] text-3xl leading-[1.25] font-medium tracking-tight text-[var(--text)] md:text-4xl">
        I build things because I want the problem to go away.
      </p>
      <div class="flex max-w-[60ch] flex-col gap-4 text-lg leading-relaxed text-[var(--text-muted)]">
        <p>
          Most of the projects here started with something I was doing
          manually and didn't want to keep doing that way. So I built a
          system for it.
        </p>
        <p>
          I'm a self-taught builder working across automation, AI, data, and
          growth. I do the backend work, the integrations, and the front end
          when needed.
        </p>
        <p>
          I like figuring out messy problems and turning them into something
          that runs more simply.
        </p>
      </div>
      <div class="flex flex-wrap gap-3.5">
        {
          chips.map((chip) => (
            <span class="font-mono-ui border border-[var(--border)] px-3 py-1.5 text-[11px] tracking-[0.08em] text-[var(--text-muted)] uppercase">
              {chip}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
