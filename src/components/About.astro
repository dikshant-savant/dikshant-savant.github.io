---
import { Image } from "astro:assets";
import headshot from "../assets/profile/headshot.png";

const chips = ["Self-taught", "3 years building and shipping", "Working remotely"];
---

<section id="about" class="scroll-mt-16 border-b border-[var(--border)] bg-[var(--surface-alt)] py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-[240px_1fr] md:gap-14">
    <div class="flex flex-col gap-3">
      <div class="aspect-[4/5] overflow-hidden border border-[var(--border)] bg-[var(--bg)]">
        <Image src={headshot} alt="Dikshant Savant" width={480} height={600} class="h-full w-full object-cover object-top" />
      </div>
      <span class="font-mono-ui text-[11px] tracking-[0.1em] text-[var(--text-muted)] uppercase">About</span>
    </div>

    <div class="flex flex-col gap-8">
      <p class="font-display max-w-[26ch] text-3xl leading-[1.25] font-medium tracking-tight text-[var(--text)] md:text-4xl">
        I build things when I can't stop thinking about how they could work better.
      </p>
      <div class="flex max-w-[60ch] flex-col gap-4 text-lg leading-relaxed text-[var(--text-muted)]">
        <p>
          I'm mostly self-taught, and I've spent the last few years jumping
          between products, automation, AI, e-commerce, SEO, and growth.
          That's probably why I don't fit neatly into one job title.
        </p>
        <p>
          I've built the product, written the code, scraped the data, set up
          the emails, talked to suppliers, dealt with compliance forms,
          launched websites, run ads, and tried to sell the thing afterwards.
        </p>
        <p>
          I like getting into a problem I don't fully understand yet and
          staying with it until I do. A lot of my projects start because
          something annoys me enough that I'd rather build a solution than
          keep doing it manually.
        </p>
      </div>
      <div class="flex flex-wrap gap-3.5">
        {
          chips.map((chip) => (
            <span class="font-mono-ui border border-[var(--border)] px-3 py-1.5 text-[11px] tracking-[0.08em] text-[var(--text-muted)] uppercase">
              {chip}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
