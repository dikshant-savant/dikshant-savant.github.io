---
import { Image } from "astro:assets";
import headshot from "../assets/profile/headshot.png";

const chips = ["Self-taught", "3 years building and shipping", "Working remotely"];
---

<section id="about" class="scroll-mt-16 border-b border-[var(--hairline)] bg-[var(--canvas)] py-20 md:py-28">
  <div class="mx-auto grid max-w-[1400px] gap-12 px-6 md:grid-cols-[1fr_220px] md:gap-16 lg:px-10">
    <div class="flex flex-col gap-6 md:order-1">
      <p class="display-md max-w-[22ch] text-2xl text-[var(--ink)] md:text-[32px]">
        I like to build things.
      </p>
      <div class="flex max-w-[62ch] flex-col gap-4 text-lg leading-relaxed text-[var(--body)]">
        <p>
          I'm mostly self-taught, and I've spent the last few years jumping
          between products, automation, AI, e-commerce, SEO, and growth.
          That's probably why I don't fit neatly into one job title.
        </p>
        <p>
          I've built the product, written the code, scraped the data, set up
          the emails, talked to suppliers, dealt with compliance forms,
          launched websites, run ads, and tried to sell the thing afterwards.
        </p>
        <p>
          I like getting into a problem I don't fully understand yet and
          staying with it until I do. A lot of my projects start because
          something annoys me enough that I'd rather build a solution than
          keep doing it manually.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 pt-2">
        {
          chips.map((chip) => (
            <span class="rounded-full bg-[var(--canvas-soft)] px-3 py-1.5 text-sm text-[var(--body)]">{chip}</span>
          ))
        }
      </div>
    </div>

    <div class="overflow-hidden rounded-xl shadow-card md:order-2 md:self-start" style="aspect-ratio: 4 / 3;">
      <Image src={headshot} alt="Dikshant Savant" width={440} height={330} class="h-full w-full object-cover object-top" />
    </div>
  </div>
</section>
